#include <iostream>
#include <vector>
#include <string>

using namespace std;

void compute_lps(const string& pat, int M, vector<int>& lps) {
    int len = 0;
    lps[0] = 0;
    int i = 1;
    while (i < M) {
        if (pat[i] == pat[len]) {
            len++;
            lps[i] = len;
            i++;
        } else {
            if (len != 0) len = lps[len - 1];
            else { lps[i] = 0; i++; }
        }
    }
}

void kmp_search(const string& pat, const string& txt) {
    int M = pat.length();
    int N = txt.length();
    vector<int> lps(M);

    compute_lps(pat, M, lps);

    int i = 0, j = 0;
    while (i < N) {
        if (pat[j] == txt[i]) { j++; i++; }
        if (j == M) {
            cout << "Pattern matched successfully at text index: " << (i - j) << "\n";
            j = lps[j - 1];
        } else if (i < N && pat[j] != txt[i]) {
            if (j != 0) j = lps[j - 1];
            else i++;
        }
    }
}

int main() {
    string text = "ABABDABACDABABCABAB";
    string pattern = "ABABCABAB";
    kmp_search(pattern, text);
    return 0;
}
