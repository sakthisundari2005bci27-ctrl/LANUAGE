#include <iostream>
#include <string>

using namespace std;

int main() {
    string a = "hello";
    string b = "world";

    cout << a.size() << " " << b.size() << "\n";
    cout << a + b << "\n";

    // Swap initial characters
    char temp = a[0];
    a[0] = b[0];
    b[0] = temp;

    cout << a << " " << b << "\n";
    return 0;
}
