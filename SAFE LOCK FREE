#include <iostream>
#include <atomic>
#include <thread>
#include <vector>

using namespace std;

template <typename T>
class LockFreeQueue {
private:
    struct Node {
        T data;
        atomic<Node*> next;
        Node(T val) : data(val), next(nullptr) {}
    };

    atomic<Node*> head;
    atomic<Node*> tail;

public:
    LockFreeQueue() {
        Node* dummy = new Node(T());
        head.store(dummy);
        tail.store(dummy);
    }

    ~LockFreeQueue() {
        while (Node* old_head = head.load()) {
            head.store(old_head->next);
            delete old_head;
        }
    }

    void enqueue(T value) {
        Node* new_node = new Node(value);
        Node* old_tail = nullptr;
        while (true) {
            old_tail = tail.load();
            Node* next_node = old_tail->next.load();
            if (old_tail == tail.load()) {
                if (next_node == nullptr) {
                    if (old_tail->next.compare_exchange_weak(next_node, new_node)) {
                        break;
                    }
                } else {
                    tail.compare_exchange_weak(old_tail, next_node);
                }
            }
        }
        tail.compare_exchange_weak(old_tail, new_node);
    }

    bool dequeue(T& result) {
        Node* old_head = nullptr;
        while (true) {
            old_head = head.load();
            Node* old_tail = tail.load();
            Node* next_node = old_head->next.load();
            if (old_head == head.load()) {
                if (old_head == old_tail) {
                    if (next_node == nullptr) return false;
                    tail.compare_exchange_weak(old_tail, next_node);
                } else {
                    result = next_node->data;
                    if (head.compare_exchange_weak(old_head, next_node)) {
                        break;
                    }
                }
            }
        }
        delete old_head;
        return true;
    }
};

int main() {
    LockFreeQueue<int> q;
    thread producer([&]() {
        for (int i = 1; i <= 5; ++i) {
            q.enqueue(i);
            cout << "Enqueued: " << i << "\n";
        }
    });

    thread consumer([&]() {
        int val;
        int caught = 0;
        while (caught < 5) {
            if (q.dequeue(val)) {
                cout << "Dequeued: " << val << "\n";
                caught++;
            }
        }
    });

    producer.join();
    consumer.join();
    return 0;
}
